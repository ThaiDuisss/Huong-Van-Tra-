      "item": [
        {
          "name": "01 - Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": null,\n  \"name\": \"Tea {{$timestamp}}\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/catalog/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create category returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.exist;",
                  "pm.collectionVariables.set('categoryId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create product without variants",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"Tra Oolong {{$timestamp}}\",\n  \"description\": \"Tra Oolong cao cap\",\n  \"imageUrl\": \"https://image.com/tea.jpg\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/catalog/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create product returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.exist;",
                  "pm.expect(body.variants).to.be.an('array').that.is.empty;",
                  "pm.collectionVariables.set('productId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Get product list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/products?categoryId={{categoryId}}&status=ACTIVE&page=0&size=10&sort=name,asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product list returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.content).to.be.an('array').that.is.not.empty;",
                  "const product = body.content.find(item => String(item.id) === pm.collectionVariables.get('productId'));",
                  "pm.expect(product).to.exist;",
                  "pm.expect(product.totalVariants).to.eql(0);"
                ]
              }
            }
          ]
        },
