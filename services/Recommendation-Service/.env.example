# Example only. Inject legitimate credentials securely; blank required values fail.
APP_ENVIRONMENT=production
APP_NAME=Recommendation-Service
APP_PORT=8090
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=recommend_app
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ECHO_SQL=false
INTERNAL_HEADER_SECRET=
INTERNAL_REPLAY_BACKEND=redis
INTERNAL_REPLAY_REDIS_URL=
INTERNAL_CONTEXT_MAX_SKEW_SECONDS=60
# Cross-customer permissions are disabled until explicitly approved/configured.
RECOMMENDATION_INTERNAL_CALLERS=
RECOMMENDATION_STAFF_ROLES=
CATALOG_SYNC_INTERNAL_CALLERS=catalog-Service
INTERNAL_SERVICE_NAME=recommendation-service
V1_ARTIFACT_PATH=artifacts/v1_hybrid_model.npz
MODEL_ARTIFACT_PATH=artifacts/lightfm_model.pkl
# The authorized endpoint caps issued responses at five for snapshot/report parity.
RECOMMENDATION_DEFAULT_LIMIT=10
RECOMMENDATION_MAX_LIMIT=50
CATALOG_SERVICE_URL=http://localhost:8081
FILE_SERVICE_URL=http://localhost:8101
AI_REPORT_EVALUATION_DAYS=7
AI_REPORT_MAX_PERIOD_DAYS=366
AI_REPORT_MAX_EVIDENCE_ROWS=20000
# API unit tests do not connect to Kafka. Worker requires a reviewed real target.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_COMPLETED_TOPIC=order.completed
KAFKA_RETURN_COMPLETED_TOPIC=notification.return.completed
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_GROUP_ID=recommendation-service-order-completed
KAFKA_AUTO_OFFSET_RESET=earliest
# External Flyway CLI keys only. No migration executes automatically in Python.
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
