    {
      "name": "Inventory Transactions",
      "item": [
        {
          "name": "14 - Stock in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock in returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.type).to.eql('STOCK_IN');",
                  "pm.expect(body.lines[0].beforeQuantity).to.eql(0);",
                  "pm.expect(body.lines[0].afterQuantity).to.eql(25);",
                  "pm.collectionVariables.set('stockInTransactionId', body.id);",
                  "pm.collectionVariables.set('stockInTransactionCode', body.transactionCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"createdBy\": {{createdBy}},\n  \"referenceType\": \"MANUAL\",\n  \"referenceId\": null,\n  \"lines\": [\n    {\n      \"inventoryItemId\": {{inventoryItemId}},\n      \"locationId\": {{locationId}},\n      \"quantity\": 25.00\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/inventory/inventory-transactions/stock-in"
          }
        },
        {
          "name": "15 - Stock adjustment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Adjustment returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.type).to.eql('ADJUSTMENT');",
                  "pm.expect(body.lines[0].quantity).to.eql(-5);",
                  "pm.expect(body.lines[0].beforeQuantity).to.eql(25);",
                  "pm.expect(body.lines[0].afterQuantity).to.eql(20);",
                  "pm.collectionVariables.set('adjustmentTransactionId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"createdBy\": {{createdBy}},\n  \"referenceType\": \"STOCK_COUNT\",\n  \"referenceId\": 501,\n  \"lines\": [\n    {\n      \"inventoryItemId\": {{inventoryItemId}},\n      \"locationId\": {{locationId}},\n      \"actualQuantity\": 20.00\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/inventory/inventory-transactions/adjustment"
          }
