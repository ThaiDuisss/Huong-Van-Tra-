    {
      "name": "Inventory Items",
      "item": [
        {
          "name": "01 - Create inventory item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('referenceId', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create item returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.itemType).to.eql('PRODUCT_VARIANT');",
                  "pm.collectionVariables.set('inventoryItemId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": {{referenceId}},\n  \"itemType\": \"PRODUCT_VARIANT\",\n  \"baseUnitId\": {{baseUnitId}},\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/inventory/inventory-items"
          }
        },
        {
          "name": "02 - Get inventory item list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Item list returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.content).to.be.an('array').that.is.not.empty;",
                  "pm.expect(body.content.some(item => String(item.id) === pm.collectionVariables.get('inventoryItemId'))).to.eql(true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inventory/inventory-items?referenceId={{referenceId}}&itemType=PRODUCT_VARIANT&status=ACTIVE&page=0&size=20&sort=id,asc"
          }
        },
