{
  "info": {
    "_postman_id": "c98d4d0a-8fe4-4b57-a6cb-15d9bf6a1fe8",
    "name": "Inventory Service - Product API Tests",
    "description": "Product, Product Variant and Barcode lifecycle API tests. Run requests in collection order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "API Gateway URL"
    },
    {
      "key": "directServiceUrl",
      "value": "http://localhost:8084",
      "description": "Inventory Service URL for direct testing"
    }
  ],
  "item": [
    {
      "name": "01 - Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parentId\": null,\n  \"name\": \"Tea {{$timestamp}}\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create category returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.exist;",
              "pm.collectionVariables.set('categoryId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create product without variants",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"Tra Oolong {{$timestamp}}\",\n  \"description\": \"Tra Oolong cao cap\",\n  \"imageUrl\": \"https://image.com/tea.jpg\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create product returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.exist;",
              "pm.expect(body.variants).to.be.an('array').that.is.empty;",
              "pm.collectionVariables.set('productId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get product list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/products?categoryId={{categoryId}}&status=ACTIVE&page=0&size=10&sort=name,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product list returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.content).to.be.an('array').that.is.not.empty;",
              "const product = body.content.find(item => String(item.id) === pm.collectionVariables.get('productId'));",
              "pm.expect(product).to.exist;",
              "pm.expect(product.totalVariants).to.eql(0);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create first variant",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('variantSku', `TOL100-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create variant returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(String(body.productId)).to.eql(pm.collectionVariables.get('productId'));",
              "pm.expect(body.sellable).to.eql(true);",
              "pm.collectionVariables.set('variantId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{variantSku}}\",\n  \"variantName\": \"100g\",\n  \"sellingPrice\": 150000,\n  \"costPrice\": 90000,\n  \"inventoryPolicy\": \"TRACK_STOCK\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}/variants"
      }
    },
    {
      "name": "05 - Create second variant",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('secondVariantSku', `TOL200-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create second variant returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('secondVariantId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{secondVariantSku}}\",\n  \"variantName\": \"200g\",\n  \"sellingPrice\": 280000,\n  \"costPrice\": 170000,\n  \"inventoryPolicy\": \"TRACK_STOCK\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}/variants"
      }
    },
    {
      "name": "06 - Reject duplicate SKU",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{variantSku}}\",\n  \"variantName\": \"Duplicate SKU\",\n  \"sellingPrice\": 100000,\n  \"costPrice\": 50000,\n  \"inventoryPolicy\": \"TRACK_STOCK\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}/variants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate SKU returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Get variants by product",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/product-variants?productId={{productId}}&status=ACTIVE&page=0&size=10&sort=sku,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Variant list returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.content.length).to.be.at.least(2);",
              "body.content.forEach(item => pm.expect(String(item.productId)).to.eql(pm.collectionVariables.get('productId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Update variant",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{variantSku}}\",\n  \"variantName\": \"100g Premium\",\n  \"sellingPrice\": 160000,\n  \"costPrice\": 95000,\n  \"inventoryPolicy\": \"TRACK_STOCK\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/product-variants/{{variantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update variant returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.variantName).to.eql('100g Premium');",
              "pm.expect(body.sellingPrice).to.eql(160000);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Create primary barcode",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('primaryBarcodeValue', `893${Date.now()}01`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create primary barcode returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.isPrimary).to.eql(true);",
              "pm.collectionVariables.set('primaryBarcodeId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcodeValue\": \"{{primaryBarcodeValue}}\",\n  \"barcodeType\": \"EAN13\",\n  \"isPrimary\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/product-variants/{{variantId}}/barcodes"
      }
    },
    {
      "name": "10 - Create secondary barcode",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('secondaryBarcodeValue', `893${Date.now()}02`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create secondary barcode returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.isPrimary).to.eql(false);",
              "pm.collectionVariables.set('secondaryBarcodeId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcodeValue\": \"{{secondaryBarcodeValue}}\",\n  \"barcodeType\": \"INTERNAL\",\n  \"isPrimary\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/product-variants/{{variantId}}/barcodes"
      }
    },
    {
      "name": "11 - Reject duplicate barcode",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcodeValue\": \"{{primaryBarcodeValue}}\",\n  \"barcodeType\": \"EAN13\",\n  \"isPrimary\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/product-variants/{{secondVariantId}}/barcodes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate barcode returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Scan primary barcode",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/barcodes/{{primaryBarcodeValue}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Barcode scan returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('variantId'));",
              "pm.expect(body.sellable).to.eql(true);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Reject deleting primary barcode",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/barcodes/{{primaryBarcodeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleting primary barcode returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Promote secondary barcode",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcodeType\": \"QR_CODE\",\n  \"isPrimary\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/barcodes/{{secondaryBarcodeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Promote barcode returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.isPrimary).to.eql(true);",
              "pm.expect(body.barcodeType).to.eql('QR_CODE');"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Delete demoted barcode",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/barcodes/{{primaryBarcodeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleting demoted barcode returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Get product detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product detail returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.variants.length).to.eql(2);"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Set product inactive",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product status update returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.status).to.eql('INACTIVE');",
              "pm.expect(body.variants[0].status).to.eql('ACTIVE');",
              "pm.expect(body.variants[0].sellable).to.eql(false);"
            ]
          }
        }
      ]
    },
    {
      "name": "18 - Scan barcode under inactive product",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory/barcodes/{{secondaryBarcodeValue}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Barcode scan returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.productStatus).to.eql('INACTIVE');",
              "pm.expect(body.sellable).to.eql(false);"
            ]
          }
        }
      ]
    },
    {
      "name": "19 - Set variant inactive",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/product-variants/{{variantId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Variant status update returns 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql('INACTIVE');"
            ]
          }
        }
      ]
    },
    {
      "name": "20 - Update product without replacing variants",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"Tra Oolong Updated\",\n  \"description\": \"Updated description\",\n  \"imageUrl\": \"https://image.com/tea-updated.jpg\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/inventory/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product update returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.name).to.eql('Tra Oolong Updated');",
              "pm.expect(body.variants.length).to.eql(2);"
            ]
          }
        }
      ]
    }
  ]
}
