### =====================================================================
### Inventory Counting Module - HTTP Requests
### IntelliJ HTTP Client
### Base URL: http://localhost:8084
### =====================================================================

### -------------------------------------------
### Variables
### -------------------------------------------

@baseUrl = http://localhost:8080/api/inventory
@branchId = 99999999-9999-9999-9999-999999999999
@token = YOUR_ACCESS_TOKEN


### =====================================================================
### 1. INVENTORY TAKE (Kiểm kê)
### =====================================================================

### -------------------------------------------
### 1.1. Tạo phiên kiểm kê — FULL (toàn bộ chi nhánh)
### -------------------------------------------
POST {{baseUrl}}/inventorytakes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "branchId": "{{branchId}}",
  "scopeType": "FULL",
  "note": "Kiểm kê cuối tháng 08/2026"
}

> {%
  client.global.set("takeId", response.body.id);
  client.log("Created take: " + response.body.countCode);
%}

### -------------------------------------------
### 1.2. Tạo phiên kiểm kê — LOCATION (theo vị trí)
### -------------------------------------------
POST {{baseUrl}}/inventorytakes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "branchId": "{{branchId}}",
  "scopeType": "LOCATION",
  "locationIds": [
    "11111111-1111-1111-1111-111111111111",
    "22222222-2222-2222-2222-222222222222"
  ],
  "note": "Kiểm kê kệ A và kệ B"
}

### -------------------------------------------
### 1.3. Tạo phiên kiểm kê — PARTIAL (theo mặt hàng)
### -------------------------------------------
POST {{baseUrl}}/inventorytakes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "branchId": "{{branchId}}",
  "scopeType": "PARTIAL",
  "inventoryItemIds": [
    "aaaa0000-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "bbbb0000-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
  ],
  "note": "Kiểm kê đột xuất mặt hàng nghi thiếu"
}

### -------------------------------------------
### 1.4. Bắt đầu kiểm kê (snapshot balance + batch)
### DRAFT → COUNTING
### -------------------------------------------
POST {{baseUrl}}/inventorytakes/{{takeId}}/start
Content-Type: application/json
Authorization: Bearer {{token}}

> {%
  // Lưu line IDs để dùng ở bước nhập đếm
  var lines = response.body.lines;
  if (lines && lines.length > 0) {
    client.global.set("lineId1", lines[0].id);
    if (lines.length > 1) client.global.set("lineId2", lines[1].id);
    if (lines.length > 2) client.global.set("lineId3", lines[2].id);
    client.log("Generated " + lines.length + " count lines");
    lines.forEach(function(line) {
      client.log("  Line: " + line.id
        + " | item=" + line.inventoryItemId
        + " | batch=" + (line.batchCode || "N/A")
        + " | snapshot=" + line.snapshotQuantity);
    });
  }
%}

### -------------------------------------------
### 1.5. Nhập số đếm (1 dòng)
### -------------------------------------------
PUT {{baseUrl}}/inventorytakes/{{takeId}}/counts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lines": [
    {
      "lineId": "{{lineId1}}",
      "countedQuantity": 95,
      "reasonCode": "DAMAGED",
      "note": "5 sản phẩm bị hỏng"
    }
  ]
}

### -------------------------------------------
### 1.6. Nhập số đếm (nhiều dòng — bao gồm batch)
### -------------------------------------------
PUT {{baseUrl}}/inventorytakes/{{takeId}}/counts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lines": [
    {
      "lineId": "{{lineId1}}",
      "countedQuantity": 95,
      "reasonCode": "DAMAGED",
      "note": "5 sản phẩm bị hỏng"
    },
    {
      "lineId": "{{lineId2}}",
      "countedQuantity": 48,
      "reasonCode": "DAMAGED",
      "note": "2 hộp bị rách (LOT cũ)"
    },
    {
      "lineId": "{{lineId3}}",
      "countedQuantity": 30,
      "note": "Khớp"
    }
  ]
}

### -------------------------------------------
### 1.7. Hoàn tất kiểm kê
### COUNTING → COMPLETED (tính variance cho tất cả dòng)
### -------------------------------------------
POST {{baseUrl}}/inventorytakes/{{takeId}}/finish
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 1.8. Xem chi tiết phiên kiểm kê
### -------------------------------------------
GET {{baseUrl}}/inventorytakes/{{takeId}}
Authorization: Bearer {{token}}

### -------------------------------------------
### 1.9. Danh sách phiên kiểm kê (có filter + phân trang)
### -------------------------------------------
GET {{baseUrl}}/inventorytakes?branchId={{branchId}}&page=0&size=20
Authorization: Bearer {{token}}

### -------------------------------------------
### 1.10. Danh sách — filter theo status
### -------------------------------------------
GET {{baseUrl}}/inventorytakes?status=COUNTING&page=0&size=20
Authorization: Bearer {{token}}

### -------------------------------------------
### 1.11. Danh sách — filter theo scope type
### -------------------------------------------
GET {{baseUrl}}/inventorytakes?scopeType=FULL&page=0&size=20
Authorization: Bearer {{token}}

### -------------------------------------------
### 1.12. Danh sách — filter kết hợp
### -------------------------------------------
GET {{baseUrl}}/inventorytakes?branchId={{branchId}}&status=COMPLETED&scopeType=FULL&page=0&size=10
Authorization: Bearer {{token}}


### =====================================================================
### 2. ADJUSTMENT (Điều chỉnh tồn kho)
### =====================================================================

### -------------------------------------------
### 2.1. Tạo phiếu điều chỉnh từ kiểm kê
### (Tự lấy variance lines từ phiên kiểm kê COMPLETED)
### -------------------------------------------
POST {{baseUrl}}/adjustments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "inventoryTakeId": "{{takeId}}",
  "branchId": "{{branchId}}",
  "reasonCode": "STOCK_COUNT",
  "note": "Điều chỉnh sau kiểm kê cuối tháng 08/2026"
}

> {%
  client.global.set("adjId", response.body.id);
  client.log("Created adjustment: " + response.body.documentCode
    + " | type=" + response.body.documentType
    + " | lines=" + response.body.lines.length);
%}

### -------------------------------------------
### 2.2. Tạo phiếu điều chỉnh standalone (không qua kiểm kê)
### -------------------------------------------
POST {{baseUrl}}/adjustments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "branchId": "{{branchId}}",
  "reasonCode": "MANUAL_CORRECTION",
  "note": "Phát hiện nhập liệu sai đơn hàng #12345",
  "lines": [
    {
      "inventoryItemId": "aaaa0000-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "locationId": "11111111-1111-1111-1111-111111111111",
      "adjustmentQuantity": 10,
      "note": "Tăng 10 — nhập thiếu từ PO-2026-001"
    },
    {
      "inventoryItemId": "bbbb0000-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "locationId": "11111111-1111-1111-1111-111111111111",
      "adjustmentQuantity": -5,
      "note": "Giảm 5 — hàng hỏng không sử dụng được"
    }
  ]
}

> {%
  client.global.set("adjStandaloneId", response.body.id);
%}

### -------------------------------------------
### 2.3. Phê duyệt phiếu điều chỉnh
### DRAFT → APPROVED
### -------------------------------------------
POST {{baseUrl}}/adjustments/{{adjId}}/approve
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.4. Hạch toán phiếu điều chỉnh
### APPROVED → POSTED
### (Cập nhật balance + tạo inventory transaction)
### -------------------------------------------
POST {{baseUrl}}/adjustments/{{adjId}}/post
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.5. Từ chối phiếu điều chỉnh
### DRAFT/APPROVED → REJECTED
### -------------------------------------------
POST {{baseUrl}}/adjustments/{{adjStandaloneId}}/reject
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.6. Xem chi tiết phiếu điều chỉnh
### -------------------------------------------
GET {{baseUrl}}/adjustments/{{adjId}}
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.7. Danh sách phiếu điều chỉnh (filter + phân trang)
### -------------------------------------------
GET {{baseUrl}}/adjustments?branchId={{branchId}}&page=0&size=20
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.8. Danh sách — filter theo status
### -------------------------------------------
GET {{baseUrl}}/adjustments?status=DRAFT&page=0&size=20
Authorization: Bearer {{token}}

### -------------------------------------------
### 2.9. Danh sách — filter theo status POSTED
### -------------------------------------------
GET {{baseUrl}}/adjustments?status=POSTED&page=0&size=20
Authorization: Bearer {{token}}


### =====================================================================
### 3. FULL WORKFLOW (Chạy tuần tự từ đầu đến cuối)
### =====================================================================

### -------------------------------------------
### 3.1. Step 1: Tạo phiên kiểm kê
### -------------------------------------------
POST {{baseUrl}}/inventorytakes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "branchId": "{{branchId}}",
  "scopeType": "FULL",
  "note": "Full workflow test"
}

> {%
  client.global.set("wfTakeId", response.body.id);
%}

### -------------------------------------------
### 3.2. Step 2: Bắt đầu (snapshot)
### -------------------------------------------
POST {{baseUrl}}/inventorytakes/{{wfTakeId}}/start
Content-Type: application/json
Authorization: Bearer {{token}}

> {%
  var lines = response.body.lines;
  if (lines) {
    for (var i = 0; i < lines.length; i++) {
      client.global.set("wfLine" + i, lines[i].id);
    }
    client.log("Snapshot done: " + lines.length + " lines");
  }
%}

### -------------------------------------------
### 3.3. Step 3: Nhập đếm (dùng line IDs từ step 2)
### -------------------------------------------
PUT {{baseUrl}}/inventorytakes/{{wfTakeId}}/counts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lines": [
    {
      "lineId": "{{wfLine0}}",
      "countedQuantity": 98,
      "reasonCode": "MISCOUNT",
      "note": "Nhập sai trước đó"
    }
  ]
}

### -------------------------------------------
### 3.4. Step 4: Hoàn tất
### -------------------------------------------
POST {{baseUrl}}/inventorytakes/{{wfTakeId}}/finish
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 3.5. Step 5: Tạo phiếu điều chỉnh từ kiểm kê
### -------------------------------------------
POST {{baseUrl}}/adjustments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "inventoryTakeId": "{{wfTakeId}}",
  "branchId": "{{branchId}}",
  "reasonCode": "STOCK_COUNT",
  "note": "Workflow test adjustment"
}

> {%
  client.global.set("wfAdjId", response.body.id);
%}

### -------------------------------------------
### 3.6. Step 6: Duyệt
### -------------------------------------------
POST {{baseUrl}}/adjustments/{{wfAdjId}}/approve
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 3.7. Step 7: Hạch toán (cập nhật tồn kho)
### -------------------------------------------
POST {{baseUrl}}/adjustments/{{wfAdjId}}/post
Content-Type: application/json
Authorization: Bearer {{token}}

### -------------------------------------------
### 3.8. Step 8: Kiểm tra kết quả
### -------------------------------------------
GET {{baseUrl}}/adjustments/{{wfAdjId}}
Authorization: Bearer {{token}}
