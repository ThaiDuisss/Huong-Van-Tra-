<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Create order" id="vnyWIORXxKy0QwiSD9W1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    title POS Order Flow - Create Counter Order (Cash)\n\n    actor Sale\n    participant POS as \&quot;POS Screen&lt;br/&gt;«Boundary»\&quot;\n    participant Ctrl as \&quot;OrdersController&lt;br/&gt;«Controller»\&quot;\n    participant Svc as \&quot;OrderLogic&lt;br/&gt;«service»\&quot;\n    participant Inv as \&quot;InventoryClient&lt;br/&gt;«service»\&quot;\n    participant Out as \&quot;OutboxWriter&lt;br/&gt;«service»\&quot;\n    participant Repo as \&quot;OrderRepository&lt;br/&gt;«repository»\&quot;\n    participant Ord as \&quot;o_Order&lt;br/&gt;«entity»\&quot;\n    participant Pay as \&quot;o_Payment&lt;br/&gt;«entity»\&quot;\n\n    Note over Sale,POS: Open POS / prepare checkout\n    Sale-&gt;&gt;+POS: 1. Open POS and confirm checkout\n    POS-&gt;&gt;+Ctrl: 1.1 GET transfer-payment-info (optional)\n    Ctrl--&gt;&gt;-POS: 1.2 Transfer payment info ready\n    POS--&gt;&gt;-Sale: 1.3 Display cart and payment panel\n\n    Note over Sale,Ctrl: Submit cash order\n    Sale-&gt;&gt;+POS: 2. Confirm cash payment\n    POS-&gt;&gt;+Ctrl: 2.1 POST /api/v1/orders (Idempotency-Key, POS, Cash)\n    Ctrl-&gt;&gt;+Svc: 2.1.1 CreateOrderAsync(request)\n    Svc-&gt;&gt;Svc: 2.1.1.1 ValidateInput(...)\n    Svc-&gt;&gt;Svc: 2.1.1.2 ApplyBusinessRules(...)\n\n    alt Input or business rules invalid\n        Svc--&gt;&gt;Ctrl: 2.1.1.3 OrderValidationException\n        Ctrl--&gt;&gt;POS: 2.1.1.4 400 Bad Request + validation messages\n        POS--&gt;&gt;Sale: 2.1.1.5 Show field errors on POS\n        deactivate Svc\n        deactivate Ctrl\n        deactivate POS\n    else Input and business rules valid\n        Svc-&gt;&gt;Svc: 2.1.1.3 BuildOrder(POS status by stock mode)\n        Svc-&gt;&gt;Svc: 2.1.1.4 BuildPayment(Cash, Success)\n        Svc-&gt;&gt;+Inv: 2.1.1.5 PreparePosStockHandling(lines)\n        Inv-&gt;&gt;Inv: 2.1.1.5.1 Check Shelf + Warehouse FG + BOM capacity\n\n        alt Shelf, Warehouse FG and BOM cannot fulfill\n            Inv--&gt;&gt;-Svc: 2.1.1.5.2 InsufficientStockResult\n            Svc--&gt;&gt;Ctrl: 2.1.1.5.3 OrderValidationException (stock)\n            Ctrl--&gt;&gt;POS: 2.1.1.5.4 400 Bad Request + stock message\n            POS--&gt;&gt;Sale: 2.1.1.5.5 Notify cannot complete sale\n            deactivate Svc\n            deactivate Ctrl\n            deactivate POS\n        else Sell-first stock handling succeeds\n            Inv-&gt;&gt;Inv: 2.1.1.5.2 Deduct available Shelf quantity\n            Inv-&gt;&gt;Inv: 2.1.1.5.3 Create StockDeductQueue when Shelf short\n            Inv--&gt;&gt;-Svc: 2.1.1.5.4 StockHandlingResult\n            Svc-&gt;&gt;+Ord: 2.1.1.6 Create o_Order instance\n            Ord--&gt;&gt;-Svc: 2.1.1.6.1 Order entity ready\n            Svc-&gt;&gt;+Pay: 2.1.1.7 Create o_Payment (Cash, Success)\n            Pay--&gt;&gt;-Svc: 2.1.1.7.1 Payment entity ready\n            Svc-&gt;&gt;+Repo: 2.1.1.8 SaveAsync(order, payment)\n            Repo--&gt;&gt;-Svc: 2.1.1.8.1 Persist completed\n            Svc-&gt;&gt;+Out: 2.1.1.9 Enqueue Outbox message (same TX)\n            Out--&gt;&gt;-Svc: 2.1.1.9.1 Outbox message persisted\n            Svc-&gt;&gt;Svc: 2.1.1.10 RecordCashSale(cash session)\n            Svc--&gt;&gt;-Ctrl: 2.1.1.11 OrderResponse\n            Ctrl--&gt;&gt;-POS: 2.1.2 201 Created + order payload\n            POS--&gt;&gt;-Sale: 2.2 Show confirmation / print receipt\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="i3ONAxV8kW_kPPxow2MF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=20;fontFamily=Times New Roman;" vertex="1">
            <mxGeometry height="2698" width="1599" as="geometry" />
          </mxCell>
        </UserObject>
