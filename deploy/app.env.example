# ===========================================================================
# Biến môi trường cho box 1 "app" (Api-Gateway + 10 service + pos-web).
# Copy thành deploy/app.env TRÊN EC2 (đừng commit: .gitignore đã chặn *.env),
# chmod 600, owner root. Mọi giá trị dưới đây là placeholder.
#
# Nguyên tắc: application-prod.yml KHÔNG để default cho giá trị nào thuộc
# hạ tầng hoặc bí mật. Thiếu biến thì service chết lúc khởi động — đó là cố ý,
# để không bao giờ có chuyện prod âm thầm nối vào VPS dev.
# ===========================================================================

SPRING_PROFILES_ACTIVE=prod

# ---- Hạ tầng trên box 2 ----
# Box 2 là EC2 ip-172-31-42-27 (VPC default 172.31.0.0/16), Tailscale 100.99.2.30.
# Dùng PRIVATE IP khi box 1 nằm cùng VPC: nhanh nhất, không qua lớp mã hoá của
# Tailscale, không phụ thuộc tailnet. Chỉ dùng 100.99.2.30 nếu box 1 ở VPC/region
# khác (lúc đó phải cài Tailscale trên box 1).
# Tuyệt đối không dùng IP public 3.107.34.56 cho traffic nội bộ.
MYSQL_HOST=172.31.42.27
KAFKA_BOOTSTRAP_SERVERS=172.31.42.27:19092
REDIS_HOST=172.31.42.27
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Tách consumer group của prod khỏi dev vì hai bên dùng chung cluster Kafka.
# Trùng group id = mỗi message chỉ một bên nhận được.
KAFKA_GROUP_PREFIX=prod-

# ---- Chung cho mọi service ----
# Secret header nội bộ. PHẢI rotate: giá trị cũ đang nằm trong application.yml
# và trong infra/Api-Gateway/aw.env đã commit lên git.
INTERNAL_HEADER_SECRET=change-me-generate-new
# 10 service x 8 = 80 kết nối. MySQL box 2 cần max_connections >= 300.
DB_POOL_MAX=8
# Bat Flyway lan dau; dat false cho cac lan chay audit chi doc.
# Da kiem 2026-11-04: ca 12 DB tren box 2 deu co flyway_schema_history va 0 migration
# failed, nen boot lan dau chi apply migration moi, khong baseline lai.
FLYWAY_ENABLED=true
# Swagger tắt mặc định ở prod; bật tạm khi cần demo.
SPRINGDOC_ENABLED=false

# ---- Tài khoản DB theo từng service (compose ghép thành SPRING_DATASOURCE_URL) ----
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=change-me
CUSTOMER_DB_USER=customer_app
CUSTOMER_DB_PASSWORD=change-me
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=change-me
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_USER=payment_app
PAYMENT_DB_PASSWORD=change-me
PROMOTION_DB_USER=promotion_app
PROMOTION_DB_PASSWORD=change-me
ORGANIZATION_DB_USER=organization_app
ORGANIZATION_DB_PASSWORD=change-me
FILE_DB_USER=file_app
FILE_DB_PASSWORD=change-me
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=change-me

# ---- Api-Gateway ----
# Issuer PHẢI là URL công khai: claim iss của token phải trùng, không thì validate fail.
KEYCLOAK_ISSUER_URI=https://auth.hvtra.id.vn/realms/hvt
KEYCLOAK_AUDIENCE=hvtra-pos
# application.yml có 2 phần tử allowed-origin-patterns nên phải set đủ 2 biến,
# không thì phần tử [1] của dev (http://127.0.0.1:*) còn lại ở prod.
CORS_ORIGIN_1=https://pos.hvtra.id.vn
CORS_ORIGIN_2=https://pos.hvtra.id.vn
# Recommendation-Service tạm chưa deploy: route /api/recommendation/ai-reports/** sẽ trả 503.
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8090

# ---- Identity-Service (Keycloak Admin REST API) ----
# auth.hvtra.id.vn da chay cong khai tren box 2 (OIDC discovery tra 200), nen dung
# thang URL cong khai: khoi phai cau hinh KC_HOSTNAME_BACKCHANNEL_DYNAMIC.
# Doi sang http://172.31.42.27:8080 neu muon admin API di duong noi bo trong VPC.
KEYCLOAK_URL=https://auth.hvtra.id.vn
KEYCLOAK_CLIENT_ID=change-me
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=hvtra-identity-admin
# Secret cũ đang nằm trong application.yml làm default -> PHẢI rotate trong Keycloak.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-rotate-in-keycloak
KEYCLOAK_PERMISSION_CLIENT_ID=hvtra-pos
KAFKA_ENABLED=true

# ---- File-Service / MinIO ----
# Box 2 da co reverse proxy cong khai: storage.hvtra.id.vn -> hvtra-infra.duckdns.org
# -> 3.107.34.56 (box 2), /minio/health/live tra 200. Nen box 1 KHONG can proxy lai
# MinIO qua Caddy nua, dung thang domain nay.
# Phai la URL cong khai vi presigned URL cua bucket private do TRINH DUYET mo,
# va chu ky presign gan voi host trong URL.
MINIO_ENDPOINT=https://storage.hvtra.id.vn
MINIO_PUBLIC_ENDPOINT=https://storage.hvtra.id.vn
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# true cho lần khởi động đầu để tạo bucket, sau đó đổi thành false.
FILE_STORAGE_INITIALIZE_BUCKETS=true

# ---- Notification-Service (SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@gmail.com
# Gmail: dùng App password 16 ký tự, không phải mật khẩu đăng nhập.
MAIL_PASSWORD=change-me
INVOICE_EMAIL_ENABLED=false
MAIL_FROM_NAME=Hương Vân Trà
STORE_NAME=Hương Vân Trà
STORE_ADDRESS=
STORE_HOTLINE=

# ---- Payment-Service (SePay) ----
SEPAY_BANK_ACCOUNT=change-me
SEPAY_BANK_ACCOUNT_NAME=change-me
SEPAY_SECRET=change-me
