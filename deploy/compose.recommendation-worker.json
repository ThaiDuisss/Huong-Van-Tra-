{
  "services": {
    "recommendation-kafka-worker": {
      "profiles": ["recommendation-worker"],
      "build": {"context": "../services/Recommendation-Service", "dockerfile": "Dockerfile"},
      "command": ["python", "-B", "scripts/run_kafka_worker.py"],
      "working_dir": "/app",
      "user": "65532:65532",
      "restart": "no",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "environment": {
        "HVTRA_WORKER_ENABLED": "${HVTRA_WORKER_ENABLED:-false}",
        "HVTRA_WORKER_ENVIRONMENT": "${HVTRA_WORKER_ENVIRONMENT:-}",
        "HVTRA_WORKER_WRITER_ROLE": "${HVTRA_WORKER_WRITER_ROLE:-}",
        "HVTRA_WORKER_BINDING_REVISION": "${HVTRA_WORKER_BINDING_REVISION:-}",
        "HVTRA_KAFKA_CLUSTER_ID": "${HVTRA_KAFKA_CLUSTER_ID:-}",
        "HVTRA_ORDER_STREAM_ID": "${HVTRA_ORDER_STREAM_ID:-}",
        "HVTRA_RETURN_STREAM_ID": "${HVTRA_RETURN_STREAM_ID:-}",
        "HVTRA_MYSQL_SERVER_ID": "${HVTRA_MYSQL_SERVER_ID:-}",
        "HVTRA_WORKER_KAFKA_SECURITY_PROTOCOL": "${HVTRA_WORKER_KAFKA_SECURITY_PROTOCOL:-}",
        "KAFKA_BOOTSTRAP_SERVERS": "${HVTRA_WORKER_KAFKA_BOOTSTRAP_SERVERS:-}",
        "KAFKA_GROUP_ID": "${HVTRA_WORKER_KAFKA_GROUP_ID:-}",
        "KAFKA_ORDER_COMPLETED_TOPIC": "${HVTRA_WORKER_ORDER_COMPLETED_TOPIC:-}",
        "KAFKA_RETURN_COMPLETED_TOPIC": "${HVTRA_WORKER_RETURN_COMPLETED_TOPIC:-}",
        "KAFKA_AUTO_OFFSET_RESET": "${HVTRA_WORKER_AUTO_OFFSET_RESET:-}",
        "KAFKA_ENABLE_AUTO_COMMIT": "false",
        "MYSQL_HOST": "${HVTRA_WORKER_MYSQL_HOST:-}",
        "MYSQL_PORT": "${HVTRA_WORKER_MYSQL_PORT:-}",
        "MYSQL_DATABASE": "${HVTRA_WORKER_MYSQL_DATABASE:-}",
        "MYSQL_USER": "${HVTRA_WORKER_MYSQL_USER:-}"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${HVTRA_WORKER_APPROVAL_DIRECTORY:-/nonexistent/hvtra-worker-approval}",
          "target": "/run/hvtra-worker-approval",
          "read_only": true,
          "bind": {"create_host_path": false}
        },
        {
          "type": "bind",
          "source": "${HVTRA_WORKER_PASSWORD_FILE:-/nonexistent/hvtra-worker-password}",
          "target": "/run/secrets/recommendation_worker_mysql_password",
          "read_only": true,
          "bind": {"create_host_path": false}
        }
      ]
    }
  }
}
