# ===========================================================================
# MOT file duy nhat cho ca 10 container cua box 1 "app".
#
#   cd deploy && cp .env.example .env && chmod 600 .env
#
# Ten phai dung la .env: docker compose dung file nay cho CA hai viec - noi suy
# ${...} trong docker-compose.prod.yml, va nap bien vao container qua env_file.
# .gitignore da chan .env. File .env rieng cua tung service trong services/*/
# la danh cho chay local bang IntelliJ, KHONG lien quan den file nay.
#
# LUU Y: moi container nhan TOAN BO bien trong file nay. Nghia la vao bat ky
# container nao go `env` cung thay het secret cua cac service khac. Chap nhan
# duoc o quy mo nay, nhung mot service bi chiem la lo het.
# ===========================================================================

SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# 1. PHAI DOI KHI LEN BOX 1
# ---------------------------------------------------------------------------
# Ha tang o box 2 (EC2 ip-172-31-42-27). Chay tu may dev qua tailnet thi dung
# 100.99.2.30; chay TREN box 1 cung VPC thi dung private IP 172.31.42.27 -
# nhanh hon, khong qua lop ma hoa Tailscale, khong phu thuoc tailnet con song.
# Tuyet doi khong dung IP public 3.107.34.56 cho traffic noi bo.
MYSQL_HOST=172.31.42.27
KAFKA_BOOTSTRAP_SERVERS=172.31.42.27:19092
REDIS_HOST=172.31.42.27
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Origin that cua web POS. Phai trung voi ban ghi DNS, va PHAI duoc dang ky
# trong Keycloak client hvtra-pos (Valid redirect URIs + Web origins) - neu
# khong Keycloak tra 400 "Invalid parameter: redirect_uri".
# application.yml co 2 phan tu allowed-origin-patterns nen phai set du 2 bien,
# khong thi phan tu [1] cua dev (http://127.0.0.1:*) con lai o prod.
POS_DOMAIN=pos.hvtra.id.vn
ACME_EMAIL=
POS_WEB_PORT=3000
CORS_ORIGIN_1=https://pos.hvtra.id.vn
CORS_ORIGIN_2=https://pos.hvtra.id.vn

# ---------------------------------------------------------------------------
# 2. CONG TAC NGHIEP VU - gia tri duoi day la gia tri CHAY THAT
# ---------------------------------------------------------------------------
# De chay smoke test o LOCAL thi tam doi thanh:
#     KAFKA_ENABLED=false
#     FLYWAY_ENABLED=false
#     KAFKA_GROUP_PREFIX=smoketest-
#     ORDER_RETURN_INVENTORY_RECONCILIATION_ENABLED=false
#     ORDER_RETURN_INVENTORY_ORPHAN_RECOVERY_ENABLED=false
# Ly do: consumer group moi + auto-offset-reset=earliest se DOC LAI TOAN BO
# lich su topic va XU LY LAI vao DB that (tru kho, cap nhat don, gui thong bao);
# Order-Service con co scheduler tu dong "recovery" don moi 60s.
#
# KHONG dat KAFKA_CONFIG_ENABLED o day: bien nay map vao kafka-config.enabled va
# se ghi de len Customer-Service - service do co y dat enabled=false.
KAFKA_ENABLED=true
FLYWAY_ENABLED=true
KAFKA_GROUP_PREFIX=prod-

# LAN KHOI DONG DAU TIEN PHAI DE latest. KAFKA_GROUP_PREFIX=prod- tao ra consumer
# group HOAN TOAN MOI, chua co committed offset nao. Ma application.yml dat
# auto-offset-reset=earliest -> group moi se DOC LAI TOAN BO LICH SU moi topic va
# XU LY LAI vao DB that: tru kho lan nua, cap nhat lai don, commit lai usage
# promotion, ban lai thong bao. Day la mat du lieu that su, khong phai log ban.
# auto-offset-reset chi co tac dung khi group CHUA co offset, nen sau lan khoi dong
# dau thanh cong thi bien nay khong con anh huong gi va co the bo di.
# Doi lai: event da duoc san xuat nhung chua ai xu ly se bi bo qua. Chap nhan duoc -
# bo qua vai event nho hon nhieu so voi xu ly lai toan bo lich su.
KAFKA_CONSUMER_CONFIG_AUTO_OFFSET_RESET=latest
ORDER_RETURN_INVENTORY_RECONCILIATION_ENABLED=true
ORDER_RETURN_INVENTORY_ORPHAN_RECOVERY_ENABLED=true

# ---------------------------------------------------------------------------
# 3. CHUNG CHO MOI SERVICE
# ---------------------------------------------------------------------------
# Secret header noi bo. PHAI rotate: gia tri cu nam trong application.yml va
# trong infra/Api-Gateway/aw.env da commit len git.
# 9 service x 8 = 72 ket noi; MySQL box 2 can max_connections >= 300.
# Swagger tat o prod, bat tam khi can demo.
INTERNAL_HEADER_SECRET=change-me-generate-new
DB_POOL_MAX=8
SPRINGDOC_ENABLED=false

# JVM mac dinh lay 25% RAM CUA MAY (2GB/service) -> 10 service la het RAM.
# MaxRAMPercentage tinh theo gioi han cgroup cua container nen an toan.
# Cron trong code (purge action log 3h sang, yearly review 1/2) la gio dia phuong
# va may dev deu o UTC+7, nen container phai cung mui gio, khong de UTC mac dinh.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -XX:+UseSerialGC
TZ=Asia/Ho_Chi_Minh

# Log: LOG_FILE_ENABLED KHONG CO TAC DUNG (logback-spring.xml dung <if> ma
# project thieu janino, va Logback 1.5 khong cho long <if> trong <root>/<logger>).
# File appender luon duoc tao, nen phai chan bang dung luong thay vi tat.
# Mac dinh cua repo la 3 appender x 1GB x 9 service = toi 27GB tren disk 30GB;
# gia tri duoi day ha tran xuong ~4GB, ghi vao volume hvtra-logs.
LOG_PATH=/app/logs
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=7
LOG_MAX_HISTORY_ACTION=30
LOG_TOTAL_SIZE_CAP=150MB
LOG_LEVEL=INFO
LOG_LEVEL_FRAMEWORK=WARN

# ---------------------------------------------------------------------------
# 4. TAI KHOAN DB TUNG SERVICE (compose ghep thanh SPRING_DATASOURCE_*)
# ---------------------------------------------------------------------------
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=change-me
CUSTOMER_DB_USER=customer_app
CUSTOMER_DB_PASSWORD=change-me
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=change-me
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_USER=payment_app
PAYMENT_DB_PASSWORD=change-me
PROMOTION_DB_USER=promotion_app
PROMOTION_DB_PASSWORD=change-me
FILE_DB_USER=file_app
FILE_DB_PASSWORD=change-me
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 5. API-GATEWAY
# ---------------------------------------------------------------------------
# Issuer PHAI la URL cong khai: claim iss cua token phai trung, khong thi
# validate fail. Recommendation-Service chua deploy -> route
# /api/recommendation/** se tra 503, dung nhu thiet ke hien tai.
KEYCLOAK_ISSUER_URI=https://auth.hvtra.id.vn/realms/hvt
KEYCLOAK_AUDIENCE=hvtra-pos
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8090

# ---------------------------------------------------------------------------
# 6. IDENTITY-SERVICE (goi Keycloak Admin REST API)
# ---------------------------------------------------------------------------
# auth.hvtra.id.vn da chay cong khai o box 2 (OIDC discovery tra 200) nen dung
# thang URL cong khai. KEYCLOAK_ADMIN_CLIENT_SECRET cu nam trong application.yml
# lam default -> PHAI rotate trong Keycloak.
KEYCLOAK_URL=https://auth.hvtra.id.vn
KEYCLOAK_CLIENT_ID=change-me
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=hvtra-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-rotate-in-keycloak
KEYCLOAK_PERMISSION_CLIENT_ID=hvtra-pos

# ---------------------------------------------------------------------------
# 7. FILE-SERVICE / MinIO
# ---------------------------------------------------------------------------
# Phai la URL CONG KHAI: presigned URL cua bucket private do TRINH DUYET mo va
# chu ky presign gan voi host trong URL. Box 2 da co reverse proxy cong khai
# (storage.hvtra.id.vn -> 3.107.34.56, /minio/health/live tra 200) nen box 1
# khong can proxy lai. initialize-buckets: true lan dau, sau do doi thanh false.
MINIO_ENDPOINT=https://storage.hvtra.id.vn
MINIO_PUBLIC_ENDPOINT=https://storage.hvtra.id.vn
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
FILE_STORAGE_INITIALIZE_BUCKETS=true

# ---------------------------------------------------------------------------
# 8. NOTIFICATION-SERVICE (SMTP - tuy chon)
# ---------------------------------------------------------------------------
# Gui hoa don mac dinh TAT. Gmail thi MAIL_PASSWORD la App password 16 ky tu.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
INVOICE_EMAIL_ENABLED=false
MAIL_FROM_NAME=Hương Vân Trà
STORE_NAME=Hương Vân Trà
STORE_ADDRESS=
STORE_HOTLINE=

# ---------------------------------------------------------------------------
# 9. PAYMENT-SERVICE (SePay)
# ---------------------------------------------------------------------------
# SePay goi webhook POST /api/payments/webhooks/sepay tu internet, nen route
# /api/payments/** phai mo cong khai qua Caddy (path webhook da permitAll o gateway).
SEPAY_BANK_ACCOUNT=change-me
SEPAY_BANK_ACCOUNT_NAME=change-me
SEPAY_SECRET=change-me

# ---------------------------------------------------------------------------
# 10. BUILD ARG CUA pos-web (bien VITE_* duoc NHUNG vao bundle luc build)
# ---------------------------------------------------------------------------
VITE_KEYCLOAK_URL=https://auth.hvtra.id.vn
VITE_KEYCLOAK_REALM=hvt
VITE_KEYCLOAK_CLIENT_ID=hvtra-pos
