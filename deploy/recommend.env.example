# Env RIENG cua Recommendation-Service tren box 1.
# Nguon: recommend (1).env do nhom cung cap, da sua cac gia tri phu thuoc moi truong.
# Compose nap theo thu tu [.env, recommend.env] nen file nay GHI DE .env chung.
# Application
APP_NAME=Recommendation-Service
APP_PORT=8090

# MySQL chung
# DOI cho box 1: tailnet -> private IP cung VPC: nhanh hon, khong qua lop ma hoa Tailscale
# (gia tri goc: 100.99.2.30)
MYSQL_HOST=172.31.42.27
MYSQL_PORT=3306
MYSQL_DATABASE=recommend_app
MYSQL_USER=recommend_app
MYSQL_PASSWORD=change-me

MYSQL_ECHO_SQL=false

# DOI cho box 1: localhost trong container khong tro toi catalog-service
# (gia tri goc: http://localhost:8081)
CATALOG_SERVICE_URL=http://catalog-service:8081
INTERNAL_HEADER_SECRET=change-me

# Internal Service
INTERNAL_SERVICE_NAME=recommendation-service

# LightFM
MODEL_ARTIFACT_PATH=artifacts/lightfm_model.pkl
RECOMMENDATION_DEFAULT_LIMIT=10
RECOMMENDATION_MAX_LIMIT=50

# Kafka
# DOI cho box 1: localhost:9092 trong container la CHINH container do, khong phai box 2
# (gia tri goc: localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=172.31.42.27:19092
KAFKA_GROUP_ID=recommendation-service-order-completed
KAFKA_ORDER_COMPLETED_TOPIC=order.completed
KAFKA_RETURN_COMPLETED_TOPIC=notification.return.completed
# DOI cho box 1: earliest + group moi = doc lai TOAN BO lich su order.completed va xu ly lai vao DB that
# (gia tri goc: earliest)
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=false

# DOI cho box 1: development TAT validate_security(): bo kiem secret >= 32 byte va bo bat buoc Redis replay store
# (gia tri goc: development)
APP_ENVIRONMENT=production
INTERNAL_REPLAY_BACKEND=redis
# DOI cho box 1: tailnet -> private IP
INTERNAL_REPLAY_REDIS_URL=redis://:change-me@172.31.42.27:6379/0

AI_REPORT_STORAGE_ORIGINS=https://storage.hvtra.id.vn

# DOI cho box 1: OFFLINE_EVALUATION tro toi file E:/... tren may Windows, khong co trong container
# (gia tri goc: OFFLINE_EVALUATION)
AI_REPORT_DATA_SOURCE=OPERATIONAL
AI_REPORT_OFFLINE_BUNDLE_PATH=E:/Huong-Van-Tra-Backup/codex-reports/2026-10-21/ai-report-integrated-v1/evaluation-bundle.json
AI_REPORT_OFFLINE_BUNDLE_SHA256=b952ecf76468350ce74ae4605136cad9f73f74d73d9f3ecf5b198cb3dd62574e

# DOI cho box 1: hai dataset BOM cung nam o E:/... khong co tren box 1
# (gia tri goc: true)
AI_REPORT_BOM_ENABLED=false

AI_REPORT_BOM_DATASET_PATH=E:/Huong-Van-Tra-Backup/codex-reports/2026-10-27/180150_ingredient-recommendation-phase2-synthetic-dataset-validation-import_evidence/synthetic-dataset/dataset.json
AI_REPORT_BOM_DATASET_SHA256=c097fc2860a7d5206e0479ac536097ac13fe1517e030148107c996dd0cfe4b6a
AI_REPORT_BOM_DATASET_ID=e320026a-182a-53a4-b31e-db3f90a895e5

AI_REPORT_BOM_MODEL_PATH=E:/Huong-Van-Tra-Backup/codex-reports/2026-10-27/184741_ingredient-recommendation-phase3-working-ai-v1-offline_evidence/research-run/ingredient-research-v1.json
AI_REPORT_BOM_MODEL_SHA256=d98563c39c53b8aa6eed665a41c1881f91905dec076ef0156604fd0db88593cb

RECOMMENDATION_STAFF_ROLES=SALE_STAFF,MANAGER,SUPER_ADMIN
