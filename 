[32m+[m[32m                                                  CONSTRAINT fk_replenishment_policy_location[m
[32m+[m[32m                                                      FOREIGN KEY (location_id) REFERENCES inventory_locations(id),[m
[32m+[m
[32m+[m[32m                                                  UNIQUE KEY uq_replenishment_policy_item_loc (inventory_item_id, location_id),[m
[32m+[m[32m                                                  INDEX idx_replenishment_policy_enabled (enabled)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m
[32m+[m[32mCREATE TABLE inventory_replenishment_alerts ([m
[32m+[m[32m                                                id BINARY(16) PRIMARY KEY,[m
[32m+[m
[32m+[m[32m                                                inventory_item_id BINARY(16) NOT NULL,[m
[32m+[m[32m                                                location_id BINARY(16) NOT NULL,[m
[32m+[m
[32m+[m[32m    -- LOW_STOCK / OUT_OF_STOCK / REORDER_REQUIRED[m
[32m+[m[32m                                                alert_type VARCHAR(50) NOT NULL,[m
[32m+[m
[32m+[m[32m    -- OPEN / ACKNOWLEDGED / ORDERED / RESOLVED[m
[32m+[m[32m                                                status VARCHAR(50) NOT NULL,[m
[32m+[m
[32m+[m[32m                                                available_quantity_snapshot DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                reorder_point_snapshot DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                suggested_quantity DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m
[32m+[m[32m                                                opened_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                                acknowledged_by BINARY(16) NULL,[m
[32m+[m[32m                                                acknowledged_at DATETIME(6) NULL,[m
[32m+[m[32m                                                ordered_at DATETIME(6) NULL,[m
[32m+[m[32m                                                resolved_at DATETIME(6) NULL,[m
[32m+[m
[32m+[m[32m    -- Allows history while enforcing one currently-active alert[m
[32m+[m[32m    -- for (item + location + alert_type).[m
[32m+[m[32m                                                open_guard TINYINT[m
[32m+[m[32m                                                    GENERATED ALWAYS AS ([m
[32m+[m[32m                                                        CASE[m
[32m+[m[32m                                                            WHEN status IN ('OPEN', 'ACKNOWLEDGED', 'ORDERED') THEN 1[m
[32m+[m[32m                                                            ELSE NULL[m
[32m+[m[32m                                                            END[m
[32m+[m[32m                                                        ) STORED,[m
[32m+[m
[32m+[m[32m                                                created_by BINARY(16) NULL,[m
[32m+[m[32m                                                created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                                updated_by BINARY(16) NULL,[m
[32m+[m[32m                                                updated_at DATETIME(6) NULL ON UPDATE CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                                version BIGINT NULL,[m
[32m+[m[32m                                                is_deleted BOOLEAN NOT NULL DEFAULT FALSE,[m
[32m+[m
[32m+[m[32m                                                CONSTRAINT fk_replenishment_alert_item[m
[32m+[m[32m                                                    FOREIGN KEY (inventory_item_id) REFERENCES inventory_items(id),[m
[32m+[m[32m                                                CONSTRAINT fk_replenishment_alert_location[m
[32m+[m[32m                                                    FOREIGN KEY (location_id) REFERENCES inventory_locations(id),[m
[32m+[m
[32m+[m[32m                                                UNIQUE KEY uq_replenishment_open_alert ([m
[32m+[m[32m                                                    inventory_item_id,[m
[32m+[m[32m                                                    location_id,[m
[32m+[m[32m                                                    alert_type,[m
[32m+[m[32m                                                    open_guard[m
[32m+[m[32m                                                    ),[m
[32m+[m[32m                                                INDEX idx_replenishment_alert_status (status),[m
[32m+[m[32m                                                INDEX idx_replenishment_alert_opened (opened_at)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m
[32m+[m[32m-- =====================================================================[m
[32m+[m[32m-- 10. BATCH GENEALOGY / TRACEABILITY[m
[32m+[m[32m--[m
[32m+[m[32m-- Critical for:[m
[32m+[m[32m-- raw material batch -> production -> finished product batch[m
[32m+[m[32m--[m
[32m+[m[32m-- Example:[m
[32m+[m[32m-- parent_batch = raw tea LOT-RAW-001[m
[32m+[m[32m-- child_batch  = tea-box LOT-FG-001[m
[32m+[m[32m-- relation_type = PRODUCTION[m
[32m+[m[32m-- reference_id = production order id[m
[32m+[m[32m-- =====================================================================[m
[32m+[m
[32m+[m[32mCREATE TABLE inventory_batch_relations ([m
[32m+[m[32m                                           id BINARY(16) PRIMARY KEY,[m
[32m+[m
[32m+[m[32m                                           parent_batch_id BINARY(16) NOT NULL,[m
[32m+[m[32m                                           child_batch_id BINARY(16) NOT NULL,[m
[32m+[m
[32m+[m[32m                                           relation_type VARCHAR(50) NOT NULL,[m
[32m+[m
[32m+[m[32m                                           reference_type VARCHAR(50) NULL,[m
[32m+[m[32m                                           reference_id VARCHAR(100) NULL,[m
[32m+[m
[32m+[m[32m                                           quantity_used DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m
[32m+[m[32m                                           created_by BINARY(16) NULL,[m
[32m+[m[32m                                           created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                           updated_by BINARY(16) NULL,[m
[32m+[m[32m                                           updated_at DATETIME(6) NULL ON UPDATE CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                           version BIGINT NULL,[m
[32m+[m[32m                                           is_deleted BOOLEAN NOT NULL DEFAULT FALSE,[m
[32m+[m
[32m+[m[32m                                           CONSTRAINT fk_batch_rel_parent[m
[32m+[m[32m                                               FOREIGN KEY (parent_batch_id) REFERENCES inventory_batches(id),[m
[32m+[m[32m                                           CONSTRAINT fk_batch_rel_child[m
[32m+[m[32m                                               FOREIGN KEY (child_batch_id) REFERENCES inventory_batches(id),[m
[32m+[m
[32m+[m[32m                                           UNIQUE KEY uq_batch_relation ([m
[32m+[m[32m                                               parent_batch_id,[m
[32m+[m[32m                                               child_batch_id,[m
[32m+[m[32m                                               relation_type,[m
[32m+[m[32m                                               reference_id[m
[32m+[m[32m                                               ),[m
[32m+[m[32m                                           INDEX idx_batch_rel_parent (parent_batch_id),[m
[32m+[m[32m                                           INDEX idx_batch_rel_child (child_batch_id),[m
[32m+[m[32m                                           INDEX idx_batch_rel_reference (reference_type, reference_id)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- =====================================================================[m
[32m+[m[32m-- END V8[m
