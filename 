[32m+[m[32m-- =====================================================================[m
[32m+[m[32m-- 9. REPLENISHMENT[m
[32m+[m[32m--[m
[32m+[m[32m-- Reorder settings belong to ITEM + LOCATION, not globally to InventoryItem.[m
[32m+[m[32m-- Existing inventory_items.reorder_point is intentionally kept as a legacy[m
[32m+[m[32m-- default until application code is migrated.[m
[32m+[m[32m-- =====================================================================[m
[32m+[m
[32m+[m[32mCREATE TABLE inventory_replenishment_policies ([m
[32m+[m[32m                                                  id BINARY(16) PRIMARY KEY,[m
[32m+[m
[32m+[m[32m                                                  inventory_item_id BINARY(16) NOT NULL,[m
[32m+[m[32m                                                  location_id BINARY(16) NOT NULL,[m
[32m+[m
[32m+[m[32m                                                  minimum_stock DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                  safety_stock DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                  reorder_point DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                  standard_reorder_quantity DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                  supplier_lead_time_days INT NOT NULL DEFAULT 0,[m
[32m+[m[32m                                                  average_daily_consumption DECIMAL(18,2) NOT NULL DEFAULT 0.00,[m
[32m+[m[32m                                                  maximum_stock DECIMAL(18,2) NULL,[m
[32m+[m
[32m+[m[32m                                                  enabled BOOLEAN NOT NULL DEFAULT TRUE,[m
[32m+[m
[32m+[m[32m                                                  created_by BINARY(16) NULL,[m
[32m+[m[32m                                                  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),[m
[32m+[m[32m                                                  updated_by BINARY(16) NULL,[m
[32m+[m[32m                                                  updated_at DATETIME(6) NULL ON UPDATE CURRENT_TIMESTAMP(6),[m
