# Được nginx render bằng envsubst lúc container khởi động (biến ${API_GATEWAY_URL}).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Mac dinh nginx chi nhan body 1MB. Upload file di bang presigned URL truc tiep
    # len MinIO nen khong qua day, nhung payload import san pham/JSON lon thi co.
    client_max_body_size 12m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Proxy API sang gateway: web và API cùng origin, không cần CORS.
    location /api/ {
        proxy_pass ${API_GATEWAY_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE thông báo cần tắt buffering
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Service worker và manifest: không cache để bản mới được nhận ngay.
    location ~* ^/(sw\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
    }

    # Asset có hash trong tên: cache dài hạn.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Trang Keycloak dùng để check SSO phải trả đúng file.
    location = /silent-check-sso.html {
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
