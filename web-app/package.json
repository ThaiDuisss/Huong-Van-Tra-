{
  "name": "web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "repo:dev": "turbo run dev",
    "repo:build": "turbo run build",
    "repo:lint": "turbo run lint",
    "repo:typecheck": "turbo run typecheck",
    "repo:test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  }
}
